{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run vercel:build",
  "crons": [
    {
      "path": "/api/cron/premarket-publish",
      "schedule": "0 1 * * 1-5"
    },
    {
      "path": "/api/cron/premarket-publish",
      "schedule": "30 1 * * 1-5"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/latest",
      "destination": "/api/latest-redirect"
    },
    {
      "source": "/latest/",
      "destination": "/api/latest-redirect"
    }
  ],
  "headers": [
    {
      "source": "/(?<slug>[0-9]{1,2}[a-z]{3}[0-9]{4})/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=604800"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
