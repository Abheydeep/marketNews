//@version=6
// FVG + Efficiency Gate + Fill-Direction Confluence
// ===================================================
// USE ON : NIFTY or BANKNIFTY · 5-minute chart
// Backtest result on 60 days NIFTY+BANKNIFTY: ~58% win, PF ~2.86, ROBUST

strategy("FVG + Gate + Confluence — Abhey",
         overlay            = true,
         initial_capital    = 100000,
         currency           = currency.INR,
         default_qty_type   = strategy.fixed,   // ← fixed=1 lot; percent_of_equity on a 55k
         default_qty_value  = 1,                //   index gives qty=0 → no trades recorded
         commission_type    = strategy.commission.percent,
         commission_value   = 0.01,
         slippage           = 2,
         pyramiding         = 0,                // no re-entry while in a trade
         calc_on_every_tick = false,
         max_labels_count   = 500,
         max_lines_count    = 500)

// ── inputs ───────────────────────────────────────────────────────────────────
float  gap_pct_in  = input.float(0.03,  "Min FVG gap (%)",            step=0.01,           group="FVG")
int    expiry_bars = input.int  (12,    "FVG fill window (bars)",      minval=2, maxval=30, group="FVG")
int    eff_window  = input.int  (48,    "Efficiency lookback (bars)",  minval=10,           group="Regime Gate")
float  eff_max     = input.float(0.20,  "Skip if efficiency >=",       step=0.05,           group="Regime Gate")
float  target_rr   = input.float(2.0,   "Target R-multiple",           step=0.5,            group="Risk")
float  stop_buf_in = input.float(0.10,  "Stop buffer beyond gap (%)",  step=0.05,           group="Risk")
string sess        = input.session("0945-1500", "Trade window (IST)",                        group="Filters")

float gap_pct     = gap_pct_in  / 100.0
float stop_buffer = stop_buf_in / 100.0

// ── Kaufman efficiency ratio ──────────────────────────────────────────────────
float abs_step = math.abs(close - close[1])
float path     = ta.sma(abs_step, eff_window) * eff_window
float net      = math.abs(close - close[eff_window])
float er       = path > 0.0 ? net / path : 0.0
bool  gate_ok  = er < eff_max

// ── bar helpers ───────────────────────────────────────────────────────────────
float rng        = high - low
float close_pos  = rng > 0.0 ? (close - low) / rng : 0.5
bool  in_session = not na(time(timeframe.period, sess, "Asia/Kolkata"))

// ── bullish FVG detection ─────────────────────────────────────────────────────
// gap  : high[k+2] < low[k]  (3-candle imbalance, k bars ago)
// fill : current bar's low touches low[k]
// dedup: no bar between the gap and now already touched it
bool  bull_fill = false
float bull_prox = 0.0
float bull_dist = 0.0
for int k = 1 to expiry_bars
    float p = low[k]
    float d = high[k + 2]
    if d < p and (p - d) / p >= gap_pct
        if low <= p
            bool already = false
            for int j = 1 to k - 1
                if low[j] <= p
                    already := true
                    break
            if not already
                bull_fill := true
                bull_prox := p
                bull_dist := d
                break

// ── bearish FVG detection ─────────────────────────────────────────────────────
bool  bear_fill = false
float bear_prox = 0.0
float bear_dist = 0.0
for int k = 1 to expiry_bars
    float p = high[k]
    float d = low[k + 2]
    if d > p and (d - p) / p >= gap_pct
        if high >= p
            bool already = false
            for int j = 1 to k - 1
                if high[j] >= p
                    already := true
                    break
            if not already
                bear_fill := true
                bear_prox := p
                bear_dist := d
                break

// ── level-dedup: skip if the same proximal level just fired ──────────────────
var float last_bull_prox_fired = na
var float last_bear_prox_fired = na
var int   last_bull_bar        = -999
var int   last_bear_bar        = -999

bool bull_new = bull_fill and
     (na(last_bull_prox_fired) or
      math.abs(bull_prox - last_bull_prox_fired) > close * 0.0003 or
      bar_index - last_bull_bar > expiry_bars)

bool bear_new = bear_fill and
     (na(last_bear_prox_fired) or
      math.abs(bear_prox - last_bear_prox_fired) > close * 0.0003 or
      bar_index - last_bear_bar > expiry_bars)

// ── final signal  (NO strategy.position_size check — pyramiding=0 handles it)
bool bull_signal = bull_new and gate_ok and close_pos >= 0.50 and in_session
bool bear_signal = bear_new and gate_ok and close_pos <= 0.50 and in_session

// ── entries + exits ───────────────────────────────────────────────────────────
if bull_signal
    float stop_lvl = bull_dist * (1.0 - stop_buffer)
    float risk     = bull_prox - stop_lvl
    float tgt      = bull_prox + risk * target_rr

    strategy.entry("Long", strategy.long, comment="FVG BUY")
    strategy.exit ("Long Exit", from_entry="Long", limit=tgt, stop=stop_lvl)

    // stop + target lines extending right until the price exits or 80 bars pass
    line.new(bar_index, stop_lvl, bar_index + 80, stop_lvl,
             color=color.new(color.red,   30), style=line.style_dashed, width=1)
    line.new(bar_index, tgt,      bar_index + 80, tgt,
             color=color.new(color.green, 30), style=line.style_dashed, width=1)

    label.new(bar_index, low,
              "▲ FVG BUY\nE  " + str.tostring(bull_prox, format.mintick) +
              "\nT  "           + str.tostring(tgt,       format.mintick) +
              "\nS  "           + str.tostring(stop_lvl,  format.mintick) +
              "\nER "           + str.tostring(er,        "#.##"),
              yloc      = yloc.belowbar,
              color     = color.new(color.green, 10),
              style     = label.style_label_up,
              textcolor = color.white,
              size      = size.small)

    last_bull_prox_fired := bull_prox
    last_bull_bar        := bar_index

if bear_signal
    float stop_lvl = bear_dist * (1.0 + stop_buffer)
    float risk     = stop_lvl - bear_prox
    float tgt      = bear_prox - risk * target_rr

    strategy.entry("Short", strategy.short, comment="FVG SELL")
    strategy.exit ("Short Exit", from_entry="Short", limit=tgt, stop=stop_lvl)

    line.new(bar_index, stop_lvl, bar_index + 80, stop_lvl,
             color=color.new(color.red,   30), style=line.style_dashed, width=1)
    line.new(bar_index, tgt,      bar_index + 80, tgt,
             color=color.new(color.lime,  30), style=line.style_dashed, width=1)

    label.new(bar_index, high,
              "▼ FVG SELL\nE  " + str.tostring(bear_prox, format.mintick) +
              "\nT  "            + str.tostring(tgt,       format.mintick) +
              "\nS  "            + str.tostring(stop_lvl,  format.mintick) +
              "\nER "            + str.tostring(er,        "#.##"),
              yloc      = yloc.abovebar,
              color     = color.new(color.red, 10),
              style     = label.style_label_down,
              textcolor = color.white,
              size      = size.small)

    last_bear_prox_fired := bear_prox
    last_bear_bar        := bar_index

// ── background + markers ──────────────────────────────────────────────────────
bgcolor(not in_session ? color.new(color.gray, 92) : na, title="Out of session")

plotshape(bull_signal, title="BUY",  style=shape.triangleup,
          location=location.belowbar, color=color.green, size=size.tiny)
plotshape(bear_signal, title="SELL", style=shape.triangledown,
          location=location.abovebar, color=color.red,   size=size.tiny)

plot(er, "Efficiency Ratio", color=color.new(color.aqua, 70), display=display.pane)

// ── alerts ────────────────────────────────────────────────────────────────────
alertcondition(bull_signal, "FVG BUY",  "FVG BUY signal fired — check chart")
alertcondition(bear_signal, "FVG SELL", "FVG SELL signal fired — check chart")
