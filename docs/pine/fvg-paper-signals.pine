//@version=5
// FVG + Gate + Confluence — Paper Signals
// =========================================
// Pine Script implementation of the strategy validated under
// services/trading-api/backtest/ (FVG retrace + Kaufman efficiency-ratio
// regime gate + fill-direction confluence + 2.0R target). Backtest result on
// 60 days of NIFTY + BANKNIFTY 5-min data: ~58% win, profit factor ~2.86,
// every fold of a 3-fold walk-forward PF >= 1.0.
//
// USE ON: NIFTY or BANKNIFTY, 5-minute timeframe. Indian NSE intraday data
// in real time requires a TradingView paid plan; the free plan gives a
// 15-min delay (fine for visualisation, not for live alerts).
//
// HOW TO INSTALL:
//   1. TradingView → Pine Editor → New blank script
//   2. Paste this whole file → Save → Add to chart
//   3. (Optional) Right-click a label → "Add alert on FVG …" to fire push /
//      email / webhook alerts when fresh signals print.

indicator("FVG + Gate + Confluence — Paper Signals (Abhey)",
          overlay=true, max_labels_count=500, max_lines_count=500)

// ── inputs ─────────────────────────────────────────────────────────────────
gap_pct_in  = input.float(0.03,  "Min FVG gap (%)",         step=0.01,  group="FVG")
expiry_bars = input.int(12,      "FVG fill window (bars)",  minval=2, maxval=20, group="FVG")
eff_window  = input.int(48,      "Efficiency lookback (bars)", minval=10, group="Regime gate")
eff_max     = input.float(0.20,  "Skip if efficiency >=",   step=0.05,  group="Regime gate")
target_rr   = input.float(2.0,   "Target R-multiple",       step=0.5,   group="Risk")
stop_buf_in = input.float(0.10,  "Stop buffer beyond gap (%)", step=0.05, group="Risk")
sess        = input.session("0945-1500", "Trade window (IST)", group="Filters")

gap_pct     = gap_pct_in  / 100.0
stop_buffer = stop_buf_in / 100.0

// ── Kaufman efficiency ratio: net / total-path over `eff_window` bars ─────
abs_step = math.abs(close - close[1])
path     = ta.sum(abs_step, eff_window)
net      = math.abs(close - close[eff_window])
eff      = path > 0 ? net / path : 0.0
gate_ok  = eff < eff_max

// ── bar metrics ───────────────────────────────────────────────────────────
rng        = high - low
close_pos  = rng > 0 ? (close - low) / rng : 0.5
in_session = not na(time(timeframe.period, sess, "Asia/Kolkata"))

// ── bullish FVG fresh first-fill on the current bar ───────────────────────
bull_fill = false
bull_prox = 0.0
bull_dist = 0.0
for k = 1 to expiry_bars
    p = low[k]
    d = high[k + 2]
    if d < p and (p - d) / p >= gap_pct
        if low <= p
            already = false
            for j = 1 to k - 1
                if low[j] <= p
                    already := true
                    break
            if not already
                bull_fill := true
                bull_prox := p
                bull_dist := d
                break

// ── bearish FVG fresh first-fill on the current bar ───────────────────────
bear_fill = false
bear_prox = 0.0
bear_dist = 0.0
for k = 1 to expiry_bars
    p = high[k]
    d = low[k + 2]
    if d > p and (d - p) / p >= gap_pct
        if high >= p
            already = false
            for j = 1 to k - 1
                if high[j] >= p
                    already := true
                    break
            if not already
                bear_fill := true
                bear_prox := p
                bear_dist := d
                break

// ── combined signal conditions ────────────────────────────────────────────
bull_signal = bull_fill and gate_ok and close_pos >= 0.50 and in_session
bear_signal = bear_fill and gate_ok and close_pos <= 0.50 and in_session

// ── plot signals ──────────────────────────────────────────────────────────
if bull_signal
    stop   = bull_dist * (1 - stop_buffer)
    risk   = bull_prox - stop
    target = bull_prox + risk * target_rr
    txt = "BUY\nE " + str.tostring(bull_prox, "#.##")
         + "\nT "  + str.tostring(target,    "#.##")
         + "\nS "  + str.tostring(stop,      "#.##")
    label.new(bar_index, low - rng * 0.3, txt,
              color=color.new(color.green, 0), style=label.style_label_up,
              textcolor=color.white, size=size.small)
    line.new(bar_index, stop,   bar_index + 12, stop,   color=color.red,   style=line.style_dashed)
    line.new(bar_index, target, bar_index + 12, target, color=color.green, style=line.style_dashed)
    alert("FVG BUY @ "  + str.tostring(bull_prox, "#.##"), alert.freq_once_per_bar)

if bear_signal
    stop   = bear_dist * (1 + stop_buffer)
    risk   = stop - bear_prox
    target = bear_prox - risk * target_rr
    txt = "SELL\nE " + str.tostring(bear_prox, "#.##")
         + "\nT "    + str.tostring(target,    "#.##")
         + "\nS "    + str.tostring(stop,      "#.##")
    label.new(bar_index, high + rng * 0.3, txt,
              color=color.new(color.red, 0), style=label.style_label_down,
              textcolor=color.white, size=size.small)
    line.new(bar_index, stop,   bar_index + 12, stop,   color=color.red,   style=line.style_dashed)
    line.new(bar_index, target, bar_index + 12, target, color=color.green, style=line.style_dashed)
    alert("FVG SELL @ " + str.tostring(bear_prox, "#.##"), alert.freq_once_per_bar)

// ── housekeeping ──────────────────────────────────────────────────────────
bgcolor(not in_session ? color.new(color.gray, 92) : na, title="Out of session")
plotchar(eff, "Efficiency ratio", "•", location.bottom, color=color.aqua, size=size.tiny)
