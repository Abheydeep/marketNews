flowchart TD
  Cron["GitHub Actions 07:00-08:00 retries"] --> Calendar["market-calendar state"]
  Incremental["GitHub Actions 08:00-09:00 incremental retries"] --> Calendar
  Calendar -->|weekend or holiday| Closed["market-closed publication event"]
  Calendar -->|trading day| Existing["check tracked archive"]
  Existing -->|exists| Reuse["reuse immutable archive"]
  Existing -->|missing| Generate["generate-daily-summary"]

  Generate --> Sources["news-sources ingest Pulse/RSS"]
  Sources --> Score["core pre-score by India relevance and market severity"]
  Score --> MarketData["resolveMarketSnapshots"]
  MarketData --> Yahoo["Yahoo Finance live snapshots"]
  MarketData --> NseIx["nse-ix.mjs GIFT Nifty scraper"]
  NseIx --> NseIxApi["nseix.com derivatives-watch API"]
  Yahoo --> MergedSnaps["merged market snapshots"]
  NseIxApi --> MergedSnaps
  MergedSnaps --> Digest
  Score --> Rerank["NVIDIA lead reranker if key exists"]
  Rerank --> Enrich["LLM article enrichment and dedup"]
  Enrich --> ImagePrompt["theme image prompt"]
  ImagePrompt -->|NVIDIA qwen-image best effort| OgAsset["out/vercel/assets/og/YYYY-MM-DD.jpg"]
  ImagePrompt -->|missing key or failure| StaticCard["static /og-card.svg fallback"]
  Enrich --> Digest["digest JSON with sourceVerification"]
  OgAsset --> Digest
  StaticCard --> Digest
  Digest --> Guard["assertPublicBriefingCopy"]
  Guard --> Archive["archive/daily/YYYY-MM-DD-HHMM-digest.json"]
  Archive --> Publish["publish-site static render"]
  Closed --> Publish
  Reuse --> Publish
  Publish --> Latest["/latest static shell or redirect target"]
  Publish --> Public["dated briefing and trading guide"]
  Publish --> QA["public copy QA"]

  Guard -->|fails| Hold["source or QA hold page"]
  QA -->|fails| Block["block deploy"]
  Manual["workflow_dispatch manual recovery"] -->|explicit allow_late or fixture only| Generate
