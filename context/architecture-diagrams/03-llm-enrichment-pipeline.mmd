flowchart TD
  Sources["RSS and HTML sources"] --> SourceFetch["bounded source fetch · concurrency 6\nNEWS_FETCH_CONCURRENCY=1..12"]
  SourceFetch --> Articles
  Articles["candidate articles"] --> Filter["market relevance and garbage filter"]
  Filter --> Score["deterministic scoring"]
  Score --> Shortlist["top 8 lead candidates"]

  Articles --> PulseCap["deterministic source diversity cap: 80"]
  PulseCap --> PulseAgent["Pulse selection: configured NVIDIA model\nmax 12 results · one 20s attempt\nkey: NVIDIA_PULSE_API_KEY"]
  PulseAgent -->|selected indices| Filter
  PulseAgent -->|timeout or invalid| PulseFallback["deterministic 12-story fallback"]
  PulseFallback --> Filter

  Shortlist --> LeadAgent["Lead reranker: nvidia/nemotron-3-ultra-550b-a55b\nenable_thinking ON · no budget cap\ntimeout 60s · key: NVIDIA_API_KEY"]
  LeadAgent --> RetryLead["timeout + 429/5xx retry/backoff"]
  RetryLead --> ValidateLead["validate ids and JSON"]
  ValidateLead -->|valid| Lead["selected lead article"]
  ValidateLead -->|invalid or no key| DeterministicLead["deterministic fallback lead"]

  Articles --> Templates["thematic read-through rules"]
  Templates --> RepeatCheck["same-template repeat detection"]
  RepeatCheck -->|first unique template| DeterministicCopy["rule-based source card copy"]
  RepeatCheck -->|repeat or generic| EditorialAgent["Editorial enrichment: configured NVIDIA model\nbatches of 16 · 50ms request stagger\ntimeout 180s · key: NVIDIA_API_KEY"]
  EditorialAgent --> RetryEditorial["timeout + 429/5xx retry/backoff"]
  RetryEditorial --> Sanitize["sanitizeArticleEditorialPatch"]
  Sanitize -->|valid| Polished["polished card copy"]
  Sanitize -->|invalid| DeterministicCopy
  Lead --> ImageScene["briefing driver scene selection"]
  ImageScene --> ImageModel["image provider: OpenAI / Gemini / NVIDIA hosted Flux"]
  ImageModel -->|success| OgJpeg["1200x675 JPEG asset"]
  ImageModel -->|fail or no key| OgFallback["static SVG OG fallback"]

  Lead --> Digest["digest assembly"]
  DeterministicLead --> Digest
  OgJpeg --> Digest
  OgFallback --> Digest
  Lead --> ScriptAgent["Long-form script sections\nconfigured NVIDIA model · concurrency 2\nSCRIPT_LLM_CONCURRENCY=1..4"]
  ScriptAgent --> Digest
  Polished --> SourceLedger["public source ledger"]
  DeterministicCopy --> SourceLedger
  SourceLedger --> CopyGuard["public copy guardrails"]
  CopyGuard -->|pass| Publishable["publishable digest"]
  CopyGuard -->|fail| Stop["fail generation"]

  Archive["committed daily archives"] --> TitleDetector["historical title detector"]
  TitleDetector -->|flagged| EligibleLead["article-level, non-liveblog source selection"]
  EligibleLead --> TitleAgent["title-only NVIDIA generation · concurrency 2 · max 2 attempts"]
  TitleAgent --> TitleValidate["plain-language, grounding, punctuation and relevance validation"]
  TitleValidate -->|invalid| SourceFallback["sanitized archived-source/context fallback"]
  TitleValidate -->|valid| Correction["title + titleCorrection metadata"]
  SourceFallback --> Correction
  Correction --> Publishable
