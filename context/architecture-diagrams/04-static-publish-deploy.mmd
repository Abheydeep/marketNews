flowchart TD
  GitHubSchedule["GitHub schedule 07:00-09:00 IST"] --> PagesWorkflow["pages.yml publish workflow"]
  VercelCron["Vercel cron watchdog every 5 min"] --> CronApi["/api/cron/premarket-publish"]
  CronApi --> ArchiveCheck["check GitHub archive and /latest freshness"]
  ArchiveCheck -->|missing/stale| ActiveRunCheck["skip if publish workflow already active"]
  ActiveRunCheck -->|dispatch| PagesWorkflow
  ArchiveCheck -->|missing after alert threshold| HardAlert["structured error log"]
  PagesWorkflow --> Digest

  Digest["out/daily or archive digest"] --> Load["publish-site loadSourceDigest"]
  Registry["public-page-registry: www origin, title, nav and social policy"] --> SharedShell["pageShell owns public document chrome and metadata"]
  RuntimeAssets["out/vercel/assets/og generated images"] --> AssetCopy["copy assets into out/site/assets"]
  Digest --> SocialCards["deterministic social-card SVG templates"]
  SocialCards --> Sharp["sharp rasterizes 1200x630 PNG cards"]
  Sharp --> AssetCopy
  Load --> Redact["redacted public payload"]
  Redact --> Pages["render public pages"]
  Registry --> Pages
  SharedShell --> Pages
  Pages --> Home["/ archive homepage"]
  Pages --> Dated["/DDmonYYYY/ and trading-guide"]
  Pages --> Latest["/latest/ and /latest/trading-guide/ shell"]
  Pages --> Hubs["indices, gift-nifty, flows, stats, moves, multibagger"]
  Pages --> SEO["sitemap, robots, manifest, OG card"]
  MovesArchive["archive/moves tracked articles"] --> MovesCopy["copy into /moves/ dated explainers"]
  MovesCopy --> Hubs

  subgraph LiveAPI["Serverless live data"]
    LiveIndices["/api/live-indices"]
    LiveIndices --> YahooLive["Yahoo Finance"]
    LiveIndices --> NseIxLive["nse-ix.mjs GIFT Nifty"]
  end

  Home --> Guard["writeGuardedFile public copy QA"]
  Dated --> Guard
  Latest --> Guard
  Hubs --> Guard
  Guard --> OutSite["out/site"]
  SEO --> OutSite
  AssetCopy --> OutSite
  OutSite --> VercelBuild["vercel-build-public copies to public"]
  VercelBuild --> Artifact["Vercel public artifact"]
  Artifact --> Deploy["production deploy"]
  Deploy --> Smoke["reliability smoke"]
  Smoke --> Live["www.marketnarrative.in"]

  Guard -->|copy violation| Block["block artifact"]
  Smoke -->|failure| Incident["debug via structured logs"]
