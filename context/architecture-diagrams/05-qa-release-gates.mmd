flowchart LR
  Context["context:verify"] --> Unit["npm test"]
  Unit --> DeployGate["test:deploy"]
  DeployGate --> PublicBuild["MARKET_NARRATIVE_DEPLOY_TARGET=public vercel:build"]
  PublicBuild --> CopyQA["public:copy:qa -- public"]
  CopyQA --> MobileSmoke["mobile:smoke -- public"]
  MobileSmoke --> LocalProd{"content or pipeline change?"}
  LocalProd -->|yes| RealLLM["local:prod with .env.local real keys"]
  RealLLM --> LocalSmoke["local:prod:smoke"]
  LocalSmoke --> ChromeQA["Chrome desktop/mobile route matrix"]
  LocalProd -->|no| ChromeQA
  ChromeQA -->|pass| Review["review and commit"]
  ChromeQA -->|extension or visual failure| VisualBlock["block release; repair Chrome or UI"]
  Review --> Push["push / merge"]
  Push --> CI["GitHub QA workflow"]
  CI --> Vercel["Vercel/GitHub Pages deploy"]
  Vercel --> ProdSmoke["reliability:smoke / prod:qa"]

  Context -->|fails| FixContext["fix stale context or ratchet"]
  DeployGate -->|fails| RCA["root cause before patch"]
  ProdSmoke -->|fails| Incident["incident note and rollback/fix"]
