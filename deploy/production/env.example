# Copy this file to /opt/marketnarrative/.env on the DigitalOcean VPS.
# Never commit the real .env file.

POSTGRES_PASSWORD=replace-with-strong-postgres-password
JWT_SECRET=replace-with-64-plus-character-shared-secret
JWT_ISSUER=market-narrative-prod
TRADING_ADMIN_EMAIL=abhey@marketnarrative.in
FRONTEND_ORIGIN=https://trade.marketnarrative.in
ABHEY_ADMIN_PASSWORD=replace-with-strong-abhey-password

# Keep false for launch. Enable only after live-order review and manual confirmation testing.
ENABLE_LIVE_ORDERS=false

# Optional for launch. Absent keys keep mock/fallback paths active.
KITE_API_KEY=
KITE_API_SECRET=
TRADING_TOKEN_KEY=
NEWSAPI_AI_KEY=
EODHD_API_KEY=
